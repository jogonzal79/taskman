// TaskMan - F1a: fundacion de datos.
//
// IMPORTANTE (invariantes del proyecto, ver CLAUDE.md):
//   * Las UNIQUE diferibles sobre `position` NO se declaran aca. Viven solo en
//     el SQL crudo de la migracion inicial, porque Prisma generaria una version
//     no diferible que se pisaria con ellas.
//   * La FK compuesta task(column_id, board_id) -> board_column(id, board_id)
//     tampoco se declara aca: es SQL crudo. La relacion `Task.column` de abajo
//     es la FK simple, con onDelete: NoAction (NO RESTRICT).
//   * Los UUID los genera la aplicacion: ningun @default(uuid()).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  // SIN extension, y es la unica forma de arreglarlo desde aca: estos 21
  // imports los escribe el generador, no una mano. Con "js" emitia
  // `./enums.js` apuntando a `enums.ts`, que solo resuelve un bundler con
  // `extensionAlias`, y Turbopack no lo implementa. La cadena "" es un valor
  // valido del generador (junto a ts/mts/cts/js/mjs/cjs) y emite `./enums`.
  //
  // `generatedFileExtension` se queda en "ts" porque NO admite otra cosa: el
  // generador `prisma-client` solo emite TypeScript (ts, mts o cts). Si algun
  // dia hiciera falta JS compilado aca, es un `tsc` encima y no una opcion.
  importFileExtension    = ""
}

// Prisma 7: la URL de conexion ya no vive aca. Migrate la toma de
// prisma.config.ts y el cliente la recibe via driver adapter (src/client.ts).
datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActorType {
  USER
  AGENT
  API
}

/// Scopes de la 7.2. En mayusculas como Priority y ActorType; la forma en
/// minuscula (read/write/delete) es la del borde HTTP y la traduce el adaptador.
enum Scope {
  READ
  WRITE
  DELETE
}

model Board {
  id          String   @id @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  columns Column[]
  tasks   Task[]

  @@map("board")
}

model Column {
  id        String   @id @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String   @db.VarChar(80)
  key       String   @db.VarChar(40)
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([boardId, key])
  @@index([boardId, position])
  @@map("board_column")
}

model Task {
  id          String    @id @db.Uuid
  boardId     String    @map("board_id") @db.Uuid
  columnId    String    @map("column_id") @db.Uuid
  title       String    @db.VarChar(200)
  description String?   @db.Text
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime? @map("due_date") @db.Date
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  board  Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column Column @relation(fields: [columnId], references: [id], onDelete: NoAction)

  @@index([columnId, position])
  @@index([boardId, priority])
  @@index([boardId, dueDate])
  @@map("task")
}

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorType  ActorType @map("actor_type")
  actorName  String    @map("actor_name") @db.VarChar(120)
  clientId   String?   @map("client_id") @db.VarChar(120)
  action     String    @db.VarChar(60)
  entityType String    @map("entity_type") @db.VarChar(40)
  entityId   String    @map("entity_id") @db.VarChar(64)
  beforeData Json?     @map("before_data")
  afterData  Json?     @map("after_data")
  requestId  String?   @map("request_id") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@map("audit_log")
}

model ApiKey {
  id        String    @id @db.Uuid
  label     String    @db.VarChar(80)
  prefix    String    @unique @db.VarChar(24)
  keyHash   String    @unique @map("key_hash") @db.VarChar(64)
  scopes    Scope[]
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("api_key")
}

/// Registros de idempotencia de la 6.5: el cuerpo de respuesta ya emitido para
/// una Idempotency-Key, para devolverlo tal cual si la peticion se repite.
///
/// DOS DESVIOS DECLARADOS de la 4.1, los dos en la clave primaria:
///
///   - la 4.1 hace PK a `key` sola. Aca la PK es COMPUESTA, `(key, client_id)`.
///     Sin el cliente, dos claves de API que elijan el mismo valor de cabecera
///     —"req-1" lo elige cualquiera— comparten fila, y la segunda se lleva de
///     vuelta el cuerpo de respuesta que guardo la primera. El mecanismo esta
///     pensado para clientes externos y agentes (ADR-005), asi que la colision
///     entre dos de ellos no es hipotetica.
///   - de ahi sale `client_id`, que la 4.1 no tiene. Es el prefijo publico de
///     la clave, con el MISMO tipo que `api_key.prefix`: son el mismo dato.
///
/// La restriccion de que `request_hash` sea hexadecimal NO esta aca: va como
/// SQL crudo en la migracion, porque Prisma no sabe expresar un CHECK.
model IdempotencyRecord {
  key          String   @db.VarChar(128)
  clientId     String   @map("client_id") @db.VarChar(24)
  requestHash  String   @map("request_hash") @db.Char(64)
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([key, clientId])
  /// Para la purga por antiguedad de la 6.5, que todavia no existe.
  @@index([createdAt])
  @@map("idempotency_record")
}
