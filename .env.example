# Copiar a .env en la raiz del repo (esta gitignoreado):
#   Copy-Item .env.example .env
#
# Este mismo archivo lo consumen:
#   - docker compose (lo lee solo, por estar en la raiz)
#   - el CLI de Prisma y Vitest en packages/db (via dotenv-cli, ver sus scripts)

# La configuracion se VALIDA AL ARRANCAR con un esquema Zod (11.2): una variable
# ausente o invalida impide el arranque con un mensaje que la nombra, en vez de
# fallar mas tarde. Los esquemas son uno por proceso: apps/web/lib/config.ts y
# apps/mcp-stdio/src/config.ts.

# --- PostgreSQL (servicio "postgres" de docker-compose.yml) ---
POSTGRES_USER=taskman
POSTGRES_PASSWORD=taskman
POSTGRES_DB=taskman
# Solo se publica en 127.0.0.1. Cambialo si el 5432 ya esta ocupado.
POSTGRES_PORT=5432

# --- Prisma ---
# En F1a esta base es tambien la base de pruebas: la suite de integracion
# hace TRUNCATE ... CASCADE entre tests, asi que apunta siempre a la instancia
# local de docker compose y nunca a una base con datos que te importen.
DATABASE_URL="postgresql://taskman:taskman@127.0.0.1:5432/taskman?schema=public"

# --- Seguridad (7.1) ---
# Pepper de servidor para el hash SHA-256 de las API keys. NO se guarda en la
# base: sin el, los hashes de api_key no se pueden recomputar. Cambiarlo
# invalida TODAS las claves emitidas, que es la unica forma de rotarlo.
# Genera el tuyo, no copies este archivo tal cual:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY_PEPPER=

# --- Limite de peticiones (7.3, 11.2) ---
# El limite es por clave y por minuto —120 de lectura, 30 de escritura— con
# ventana deslizante EN MEMORIA: muere con el proceso y se duplica por
# instancia. Ausente queda ENCENDIDO, que es el valor que protege; solo el texto
# "false" lo apaga, y cualquier otro valor impide el arranque.
# La suite de apps/web lo apaga por su cuenta (ver su vitest.config.ts).
RATE_LIMIT_ENABLED=true

# --- Log (11.1, 11.2) ---
# debug, info, warn o error. Ausente o vacia equivale a info; cualquier otro
# valor IMPIDE el arranque, porque quien escribio LOG_LEVEL=verbose esta
# diagnosticando y arrancar en info le daria menos lineas de las que cree tener.
# La consumen las dos apps: apps/web escribe su linea por peticion al fd 1 y
# apps/mcp-stdio al fd 2, porque ahi el fd 1 es el canal del protocolo MCP.
LOG_LEVEL=info

# --- Operaciones destructivas por MCP (8.3.2, 11.2) ---
# Gobierna delete_task en /mcp, el servidor MCP por HTTP de apps/web.
#   confirm  la primera llamada no borra: devuelve la tarea para que el agente la
#            muestre, y recien la segunda, con confirm: true, la elimina.
#   allow    borra de inmediato.
#   deny     la herramienta no se ofrece y no borra.
# Ausente o vacia equivale a confirm; cualquier otro valor IMPIDE el arranque,
# porque quien escribio "denyy" cree tener el borrado apagado y lo tendria
# encendido. Es independiente de los scopes: una clave sin `delete` no ve
# delete_task con ninguna politica.
# apps/mcp-stdio NO la lee de aca: la toma del bloque env de su .mcp.json, asi
# que cada proceso puede tener una politica distinta.
MCP_DESTRUCTIVE_POLICY=confirm
