# Copiar a .env en la raiz del repo (esta gitignoreado):
#   Copy-Item .env.example .env
#
# Este mismo archivo lo consumen:
#   - docker compose (lo lee solo, por estar en la raiz)
#   - el CLI de Prisma y Vitest en packages/db (via dotenv-cli, ver sus scripts)

# --- PostgreSQL (servicio "postgres" de docker-compose.yml) ---
POSTGRES_USER=taskman
POSTGRES_PASSWORD=taskman
POSTGRES_DB=taskman
# Solo se publica en 127.0.0.1. Cambialo si el 5432 ya esta ocupado.
POSTGRES_PORT=5432

# --- Prisma ---
# En F1a esta base es tambien la base de pruebas: la suite de integracion
# hace TRUNCATE ... CASCADE entre tests, asi que apunta siempre a la instancia
# local de docker compose y nunca a una base con datos que te importen.
DATABASE_URL="postgresql://taskman:taskman@127.0.0.1:5432/taskman?schema=public"

# --- Seguridad (7.1) ---
# Pepper de servidor para el hash SHA-256 de las API keys. NO se guarda en la
# base: sin el, los hashes de api_key no se pueden recomputar. Cambiarlo
# invalida TODAS las claves emitidas, que es la unica forma de rotarlo.
# Genera el tuyo, no copies este archivo tal cual:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEY_PEPPER=
